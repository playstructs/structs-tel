# Copy to .env and fill in. Never commit .env or config/secrets/.

# --- Docker network of the running guild stack ---
GUILD_DOCKER_NETWORK=docker-structs-guild_default

# --- Public names (TLS terminates at your reverse proxy / Caddy) ---
MATRIX_SERVER_NAME=matrix.crew.oh.energy
SYNAPSE_PUBLIC_BASEURL=https://matrix.crew.oh.energy/
MAS_PUBLIC_BASE=https://auth.crew.oh.energy/
OIDC_ISSUER=https://crew.oh.energy

# MAS upstream provider ULID — generate once (e.g. https://www.ulidtools.com)
# Callback MAS will use: ${MAS_PUBLIC_BASE}upstream/callback/${MAS_UPSTREAM_PROVIDER_ID}
MAS_UPSTREAM_PROVIDER_ID=01REPLACE_WITH_ULID0000000000

# Must match webapp seed: bin/console app:oidc:seed-client
OIDC_MAS_CLIENT_ID=matrix-auth-service
OIDC_MAS_CLIENT_SECRET=replace-with-openssl-rand-base64-32

# Shared secret between Synapse and MAS (same value in both configs)
MAS_SYNAPSE_SHARED_SECRET=replace-with-openssl-rand-hex-32

# --- Postgres on guild structs-pg ---
STRUCTS_PG_HOST=structs-pg
STRUCTS_PG_PORT=5432
# Admin used only by: docker compose --profile init run --rm matrix-db-init
MATRIX_DB_ADMIN_USER=structs
MATRIX_DB_ADMIN_DATABASE=structs
# PGPASSWORD=  # set if admin user requires a password on your deploy

SYNAPSE_DB_NAME=synapse
SYNAPSE_DB_USER=synapse
SYNAPSE_DB_PASSWORD=replace-me

MAS_DB_NAME=mas
MAS_DB_USER=mas
MAS_DB_PASSWORD=replace-me

# Synapse extras (from scripts/generate-secrets.sh)
REGISTRATION_SHARED_SECRET=replace-me
MACAROON_SECRET_KEY=replace-me
FORM_SECRET=replace-me

# Published ports (client APIs default to localhost; put Caddy in front)
MAS_HTTP_BIND=127.0.0.1
MAS_HTTP_PORT=8081
SYNAPSE_CLIENT_BIND=127.0.0.1
SYNAPSE_CLIENT_PORT=8008
SYNAPSE_FEDERATION_BIND=0.0.0.0
SYNAPSE_FEDERATION_PORT=8448
